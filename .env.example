# OpenAI 兼容接口（必填 LLM_API_KEY）
LLM_API_KEY=
# 留空 = OpenAI 官方；用 DeepSeek / 通义千问等时填对应地址
LLM_BASE_URL=
LLM_MODEL=gpt-5.4-mini

# 可选：只在填写时发送（不同模型支持的参数不同，被拒绝时会自动去掉）
# 注意：gpt-5.4-mini 在 /v1/chat/completions 上不支持「function tools + reasoning_effort」，
# 服务端会返回 400（实测，见 examples/runs/*/meta.json），因此本项目留空，按默认 none 运行
LLM_REASONING_EFFORT=
# 非推理模型（如 gpt-4o-mini、deepseek-chat）可设 0 提高可复现性
LLM_TEMPERATURE=
